# REQUIRED for stable signed sessions. Generate a long random value and keep it secret.
CAREEROS_SECRET_KEY=replace-with-a-unique-64-character-random-secret
CAREEROS_DATA_DIR=./data
CAREEROS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
CAREEROS_ENABLE_API_DOCS=0

# Context-aware text coaching / role analysis (OpenAI-compatible chat completions)
AI_API_KEY=replace-with-your-provider-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Realtime speech-to-speech. Keep this server-side; the browser receives only a short-lived client secret.
OPENAI_API_KEY=replace-with-your-openai-key
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
